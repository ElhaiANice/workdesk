# Copy this file to ".env" (same folder) and fill in what you use. Everything is optional.

# --- Jira (read tickets; moving a task also moves the ticket) ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
# Jira Cloud: account email + API token  (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=you@yourcompany.com
JIRA_TOKEN=
# Jira Server / Data Center: personal access token instead of the two lines above
# JIRA_PAT=
# Which tickets "Sync my tickets" pulls (default: assigned to you and unresolved)
# JIRA_JQL=assignee = currentUser() AND resolution = Unresolved ORDER BY updated DESC
# Set to off to never change ticket statuses in Jira
# JIRA_PUSH=off

# --- Automatic Jira sync (defaults shown: three times a day on work days) ---
# WORKDESK_SYNC=off
# WORKDESK_SYNC_TIMES=09:00,13:00,17:00
# WORKDESK_SYNC_DAYS=sun,mon,tue,wed,thu

# --- Misc ---
# Folder that holds your repos; "Work on this with Claude" opens the task's repo under it
# WORKDESK_REPOS=C:\path\to\repositories